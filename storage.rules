rules_version = '2';

// QIC Service Management — Firebase Storage security rules.
//
// Previously managed only in the Firebase console, invisible to this repo —
// which is exactly why the correspondence-attachments upload broke silently
// when that feature shipped without a matching rule here. Every path must
// be explicitly allowed; Storage denies anything unmatched by default.
//
// Reads require a signed-in user. That doesn't break the app's plain
// <img>/<a> tags, or links in emails sent to customers: every URL the app
// and the mail-ingest function hand out is a download URL carrying its own
// access token (getDownloadURL on the client, firebaseStorageDownloadTokens
// in functions/index.js), and Firebase serves a file for a valid token
// without checking these rules. What these rules do govern is access
// without a token: with an open read rule, anyone who knew or guessed a
// file's path (a timestamp plus the original filename) could download
// that customer attachment.
//
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    // The campground map image shown on the Site Map tab.
    match /campground-map/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Files attached to outgoing correspondence emails (Correspondence
    // reply box, Work Order "Email Customer", service request replies).
    match /correspondence-attachments/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
